//1563. Stone Game V
class Solution {
    public int stoneGameV(int[] stoneValue) {
        int n = stoneValue.length, p = 0, max = 0; 
        int[] pre = new int[n], mid = new int[n];
        int[][] left = new int[n][n], right = new int[n][n]; // left and right current max sum
        for (int i = 0; i < n; ++i) {
            int v = stoneValue[i];
            pre[i] = p += v; // prefix sum
            mid[i] = i; // "middle" point
            left[i][i] = v; // base case
            right[i][i] = v;
        }
        for (int i = 2; i <= n; ++i) { // distance between start and end point
            for (int s = 0; s <= n - i; ++s) {
                max = 0;
                int e = s + i - 1, b = s == 0 ? 0 : pre[s - 1], total = pre[e] - b, middle = ((total + 1) >> 1) + b;
                int leftMax = left[s][e - 1], rightMax = right[s + 1][e], k = mid[s];
                while (k < e && pre[k] < middle) ++k; // find the middle point
                if (k == s) max = rightMax;
                else if (k == e) max = leftMax;
                else if (((pre[k] - b) << 1) == total) max = Math.max(left[s][k], right[k + 1][e]);
                else max = Math.max(left[s][k - 1], right[k + 1][e]);
                max += total; // add the current total sum, to facilitate the next distance loop
                left[s][e] = Math.max(max, leftMax);  // reduce redundant calculation
                right[s][e] = Math.max(max, rightMax);
                mid[s] = k; // update middle point
            }
        }
        return max == 0 ? 0 : max - pre[n - 1];
    }
}
