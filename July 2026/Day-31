//Minimum Number of Pushes to Type Word II
class Solution {
    public int minimumPushes(String word) {
        int f[]=new int[26];
        int n=word.length();
        for(int i=0;i<n;i++){
            f[word.charAt(i)-'a']++;
        }
        Arrays.sort(f);
        int ans=0;
        int btn=8;
        for(int i=25;i>=0;i--){
            if(f[i]!=0){
                ans+=f[i]*(btn/8);
                btn++;
            }
        }
        return ans;
    }
}
