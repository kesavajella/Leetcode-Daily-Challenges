//1541. Minimum Insertions to Balance a Parentheses String
class Solution {
    public int minInsertions(String s) {
        char[] arr = s.toCharArray();
        int n = arr.length;
        int ans = 0;
        int count = 0;

        for (int i = 0; i < n; i++) {
            if (arr[i] == '(') {
                count++;
            } else {
                if (count == 0) {
                    count++;
                    ans++;
                }

                if (i + 1 < n) {
                    i++;
                    if (arr[i] == '(') {
                        ans++;
                    } else {
                        count--;
                    }
                } else {
                    ans++;
                    count--;
                }
            }
        }

        return ans + 2 * count;
    }
}
